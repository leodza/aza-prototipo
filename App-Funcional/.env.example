# Configuración del despliegue en la nube.
# Copiar a `.env` y cambiar TODAS las claves antes de publicar el servidor.

# --- PostgreSQL (base estructurada) ---
POSTGRES_DB=aza
POSTGRES_USER=aza
POSTGRES_PASSWORD=cambia-esta-clave

# --- MinIO / S3 (base no estructurada: imágenes de ráfaga) ---
MINIO_ROOT_USER=azaadmin
MINIO_ROOT_PASSWORD=cambia-esta-clave-tambien
AZA_S3_BUCKET=aza-capturas
AZA_S3_REGION=us-east-1

# --- Sesión de la aplicación ---
# Clave con la que se firman los JWT. Usar una cadena larga y aleatoria.
AZA_SECRETO=genera-una-cadena-larga-y-aleatoria
